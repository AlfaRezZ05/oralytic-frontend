# URL Backend REST API Laravel (tanpa trailing slash)
# Saat development lokal bisa dikosongkan agar memakai proxy Vite (/api/v1 -> http://127.0.0.1:8000)
# Saat deploy di Rumahweb, isi dengan URL hosting Backend, contoh:
# VITE_API_BASE_URL=https://api.domain-anda.com/api/v1
VITE_API_BASE_URL=

# URL Hosting AI Engine (opsional jika menggunakan endpoint AI Engine terpisah)
# VITE_AI_ENGINE_URL=https://ai.domain-anda.com
VITE_AI_ENGINE_URL=

# API Key Gemini (jika pemanggilan AI langsung dari frontend)
VITE_GEMINI_API_KEY=
